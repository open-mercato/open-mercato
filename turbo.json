{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "32",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": ["scripts/build-package.mjs", "scripts/watch.mjs", "scripts/lib/add-js-extension.mjs"],
  "tasks": {
    "build": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "generated/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@open-mercato/cli#build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "generated/**",
        "$TURBO_ROOT$/packages/create-app/agentic/**",
        "$TURBO_ROOT$/packages/create-app/template/src/modules/example/**",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/BACKWARD_COMPATIBILITY.md",
        "$TURBO_ROOT$/packages/*/src/modules/*/agentic/standalone-guide.md"
      ],
      "outputs": ["dist/**"]
    },
    "create-mercato-app#build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "generated/**"],
      "outputs": ["dist/**"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "mcp:dev": {
      "cache": false,
      "persistent": true
    },
    "mcp:serve": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "cache": true,
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": []
    },
    "create-mercato-app#test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "generate": {
      "cache": false,
      "outputs": [".mercato/**"]
    },
    "db:generate": {
      "cache": false,
      "outputs": []
    },
    "db:migrate": {
      "cache": false,
      "outputs": []
    },
    "db:greenfield": {
      "cache": false,
      "outputs": []
    },
    "reinstall": {
      "cache": false,
      "outputs": []
    },
    "initialize": {
      "cache": false,
      "outputs": []
    },
    "seed:defaults": {
      "cache": false,
      "outputs": []
    }
  }
}
