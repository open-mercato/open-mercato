{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "plugins": [{ "name": "next" }],
    "verbatimModuleSyntax": false,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "#generated/entities.ids.generated": ["../../packages/ui/.storybook/fixtures/entity-ids.ts"],
      "@open-mercato/events/*": ["../../packages/events/src/*"],
      "@open-mercato/search/*": ["../../packages/search/src/*"],
      "@open-mercato/ui/*": ["../../packages/ui/src/*"],
      "@open-mercato/shared/*": ["../../packages/shared/src/*"],
      "@open-mercato/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "out", ".cache"]
}
