# Git and version control
.git
.gitignore
.github

# IDE and editor files
.vscode
.idea
*.swp
*.swo
**/.DS_Store

# Build outputs (will be rebuilt in container)
node_modules
**/node_modules
.next
**/.next
dist
**/dist
coverage
**/coverage
.turbo
**/.turbo

# Generated files and local runtime state (regenerated or rebuilt in the container).
# apps/mercato/.mercato holds generated/ (rebuilt by `yarn generate`), next/ (the Next.js distDir with local
# dev and build caches, rebuilt by `yarn build`), plus local cache/, logs/ and queue/ state. Sending it
# made `COPY apps/ ./apps/` ship several GB of local caches into the image.
apps/mercato/.mercato
packages/core/generated

# Agent and tooling workspaces (never copied by the Dockerfile; only inflate the build context)
.ai
.claude

# Perf harness local state and secrets (gitignored; never part of an image)
perf/.state
perf/data
perf/results
perf/config/*.local.env

# Local development files
**/.env*
!**/.env.example
*.log
tmp
.queue
**/.queue

# Yarn cache and state files
.yarn/install-state.gz
.yarn/cache
.pnp.*

# Documentation build artifacts (source needed for docs image)
docs/build
docs/.docusaurus
apps/docs/build
apps/docs/.docusaurus

# Docker files (exclude root, allow app-specific)
Dockerfile
docker-compose*.yml

# Test files and testing utilities (not used in production builds)
# Keep runtime helper sources under src/**/testing/ in the context.
# The file-level patterns and __tests__/ exclusion below are sufficient for actual test code.
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/__tests__
**/tests

# CI-only scripts (not used during Docker builds)
scripts/merge-coverage.mjs
scripts/i18n-check-sync.ts
scripts/i18n-check-usage.ts

# Development certificates
certs

# Data directories (should be mounted as volumes)
data
storage
apps/mercato/storage

# CI/CD
.github
.vscode
