{
  "name": "@open-mercato/business-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight, transport-neutral business agent runtime for Open Mercato",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./bin-path": {
      "types": "./src/bin-path.ts",
      "import": "./dist/bin-path.js"
    }
  },
  "bin": {
    "om-business-harness": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js serve",
    "run:stdio": "node dist/cli.js run --stdio",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.23",
    "@ai-sdk/openai": "^4.0.23",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.4",
    "ajv": "^8.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "7.0.2"
  }
}
