{
  "name": "@open-mercato/cache-provider-managed-kit",
  "version": "0.11.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Shared Enterprise activation gate, short-lived credential refresh and managed RESP connection helpers for the official Open Mercato managed cloud cache providers. Commercial package; requires Enterprise activation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node watch.mjs",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./test-support/index.ts",
      "default": "./test-support/index.ts"
    },
    "./testing/*": {
      "types": "./test-support/*.ts",
      "default": "./test-support/*.ts"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "cache",
    "open-mercato",
    "cache-provider",
    "enterprise"
  ],
  "peerDependencies": {
    "@open-mercato/cache": ">=0.11.0"
  },
  "dependencies": {
    "@open-mercato/cache-redis-protocol": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@open-mercato/cache": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "ioredis": "^6.0.0",
    "jest": "^30.4.2",
    "testcontainers": "^12.0.3",
    "ts-jest": "^29.4.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-mercato/open-mercato",
    "directory": "packages/cache-provider-managed-kit"
  }
}
