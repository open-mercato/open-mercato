{
  "name": "@open-mercato/cache-provider-infinispan",
  "version": "0.11.0",
  "license": "MIT",
  "description": "Open Mercato cache provider for a dedicated remote cache on an Infinispan Server cluster (Hot Rod)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "test": "jest --config jest.config.cjs",
    "test:containers": "OM_CACHE_PROVIDER_CONTAINER_TESTS=1 jest --config jest.config.cjs --runInBand --testPathPatterns container --testPathIgnorePatterns qualify",
    "qualify": "OM_CACHE_PROVIDER_CONTAINER_TESTS=1 jest --config jest.config.cjs --runInBand src/__tests__/qualify.container.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "README.md"
  ],
  "keywords": [
    "open-mercato",
    "cache",
    "cache-provider",
    "infinispan",
    "hotrod"
  ],
  "dependencies": {
    "infinispan": "0.16.3",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@open-mercato/cache": "workspace:^"
  },
  "devDependencies": {
    "@open-mercato/cache": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "jest": "^30.4.2",
    "testcontainers": "^12.0.3",
    "ts-jest": "^29.4.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-mercato/open-mercato",
    "directory": "packages/cache-provider-infinispan"
  }
}
