{
  "name": "@open-mercato/cache",
  "version": "0.11.0",
  "license": "MIT",
  "description": "Multi-strategy cache service with tag-based invalidation support",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node watch.mjs",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./*": {
      "types": [
        "./src/*.ts"
      ],
      "default": "./dist/*.js"
    },
    "./*/*": {
      "types": [
        "./src/*/*.ts"
      ],
      "default": "./dist/*/*.js"
    }
  },
  "keywords": [
    "cache",
    "caching",
    "redis",
    "sqlite",
    "memory",
    "tags",
    "invalidation"
  ],
  "peerDependencies": {
    "better-sqlite3": ">=9.0.0",
    "ioredis": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "dependencies": {
    "@open-mercato/cache-provider-jsonfile": "workspace:*",
    "@open-mercato/cache-provider-kit": "workspace:*",
    "@open-mercato/cache-provider-memory": "workspace:*",
    "@open-mercato/cache-provider-redis-legacy": "workspace:*",
    "@open-mercato/cache-provider-sqlite": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-mercato/open-mercato",
    "directory": "packages/cache"
  }
}
