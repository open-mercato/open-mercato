{
  "name": "@open-mercato/document-generators",
  "version": "0.6.7",
  "license": "MIT",
  "description": "Extensible document generation module for Open Mercato with built-in PDF and Markdown rendering",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node watch.mjs",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./modules/document_generators/providers/react-pdf": {
      "types": "./src/modules/document_generators/providers/react-pdf/index.ts",
      "default": "./dist/modules/document_generators/providers/react-pdf/index.js"
    },
    "./*.ts": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./*.tsx": {
      "types": "./src/*.tsx",
      "default": "./dist/*.js"
    },
    "./*.json": "./src/*.json",
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./dist/*.js"
    },
    "./*/*.json": "./src/*/*.json",
    "./*/*": {
      "types": [
        "./src/*/*.ts",
        "./src/*/*.tsx"
      ],
      "default": "./dist/*/*.js"
    },
    "./*/*/*.json": "./src/*/*/*.json",
    "./*/*/*": {
      "types": [
        "./src/*/*/*.ts",
        "./src/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*.js"
    },
    "./*/*/*/*.json": "./src/*/*/*/*.json",
    "./*/*/*/*": {
      "types": [
        "./src/*/*/*/*.ts",
        "./src/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*.js"
    },
    "./*/*/*/*/*.json": "./src/*/*/*/*/*.json",
    "./*/*/*/*/*": {
      "types": [
        "./src/*/*/*/*/*.ts",
        "./src/*/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*/*.js"
    },
    "./*/*/*/*/*/*.json": "./src/*/*/*/*/*/*.json",
    "./*/*/*/*/*/*": {
      "types": [
        "./src/*/*/*/*/*/*.ts",
        "./src/*/*/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*/*/*.js"
    }
  },
  "dependencies": {
    "@react-pdf/renderer": "4.3.0"
  },
  "peerDependencies": {
    "@mikro-orm/core": "^7.1.8",
    "@mikro-orm/decorators": "^7.1.8",
    "@mikro-orm/postgresql": "^7.1.8",
    "@open-mercato/shared": "workspace:*",
    "@open-mercato/ui": "workspace:*",
    "@tanstack/react-table": "^9.0.0",
    "lucide-react": "^1.27.0",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mikro-orm/core": "^7.1.8",
    "@mikro-orm/decorators": "^7.1.8",
    "@mikro-orm/postgresql": "^7.1.8",
    "@open-mercato/shared": "workspace:*",
    "@open-mercato/ui": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@tanstack/react-table": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "glob": "^13.0.6",
    "jest": "^30.4.2",
    "lucide-react": "^1.27.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-jest": "^29.4.12",
    "typescript": "7.0.2",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-mercato/open-mercato",
    "directory": "packages/document-generators"
  }
}
