{
  "name": "@open-mercato/web-research-browser",
  "version": "0.8.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "om-web-research-sidecar": "./dist/sidecar.js"
  },
  "openMercato": {
    "webResearchAdapter": {
      "id": "browser"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node watch.mjs",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*.ts": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": [
        "./src/*.ts"
      ],
      "default": "./dist/*.js"
    }
  },
  "peerDependencies": {
    "@open-mercato/web-research": "^0.6.0"
  },
  "dependencies": {
    "@open-mercato/web-research-serp": "workspace:*",
    "playwright": "^1.63.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@open-mercato/web-research": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.1",
    "glob": "^13.0.6",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-mercato/open-mercato",
    "directory": "packages/web-research-browser"
  }
}
