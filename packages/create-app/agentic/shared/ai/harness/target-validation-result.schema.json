{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-mercato.dev/schemas/standalone-target-validation-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "sourceResult", "beforeValidationFingerprint", "targetFingerprint", "commands", "status"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "pattern": "^OMH-[0-9]{3}$" },
    "sourceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 300 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "beforeValidationFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targetFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commands": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "exitStatus", "durationMs"],
        "properties": {
          "command": { "enum": ["yarn generate", "yarn typecheck", "yarn lint", "yarn build"] },
          "status": { "const": "pass" },
          "exitStatus": { "const": 0 },
          "durationMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "status": { "const": "pass" }
  }
}
