{
  "type": "object",
  "additionalProperties": false,
  "required": ["selectedRouter", "selectedSkills", "selectedContext", "decisions", "violations"],
  "properties": {
    "selectedRouter": { "type": "array", "items": { "type": "string", "enum": ["architecture", "module-data", "backend-ui", "umes", "integration", "ai-workflow", "testing", "debugging", "spec-pr", "framework-context"] } },
    "selectedSkills": { "type": "array", "items": { "type": "string", "pattern": "^om-[a-z0-9-]+$", "maxLength": 100 } },
    "selectedContext": { "type": "array", "items": { "type": "string", "maxLength": 300 } },
    "decisions": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 100 } },
    "specRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reasonCodes"],
      "properties": {
        "decision": { "type": "string", "enum": ["spec-first", "direct", "reuse-spec", "ask"] },
        "reasonCodes": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$", "maxLength": 60 } },
        "coveringSpecPath": { "type": "string", "maxLength": 300 }
      }
    },
    "violations": { "type": "array", "items": { "type": "string", "maxLength": 4096 } }
  }
}
