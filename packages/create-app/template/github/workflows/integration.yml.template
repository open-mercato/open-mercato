# Generated by create-mercato-app {{PACKAGE_VERSION}}. This file is yours: edit freely. No Open Mercato command rewrites it.
# Runs the app's own Playwright integration suite (`yarn test:integration:ephemeral --app-only`).
# Set the repository variable OM_CI_INTEGRATION_RUNS_ON to pick a runner without editing this file.
# Pull requests from forks always run on ubuntu-latest.
# Docs: https://docs.openmercato.com/customization/standalone-app#continuous-integration
name: Integration

on:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: integration-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  integration:
    name: Integration tests
    runs-on: ${{ github.event.pull_request && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-latest' || vars.OM_CI_INTEGRATION_RUNS_ON || vars.OM_CI_RUNS_ON || 'ubuntu-latest' }}
    timeout-minutes: 45
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Setup Node.js
        uses: actions/setup-node@v7
        with:
          node-version: 24

      - name: Enable Corepack
        run: corepack enable

      - name: Cache Yarn packages
        uses: actions/cache@v6
        with:
          path: |
            .yarn/cache
            ~/.yarn/berry/cache
          key: yarn-${{ runner.os }}-${{ hashFiles('yarn.lock') }}
          restore-keys: yarn-${{ runner.os }}-

      - name: Check yarn.lock is committed
        run: node scripts/ci.mjs --check-lockfile

      - name: Install dependencies
        run: yarn install --immutable

      - name: Prepare environment
        run: node scripts/ci.mjs --prepare-env

      - name: Install Playwright browsers
        run: npx playwright install --with-deps chromium

      - name: Run integration tests
        # The suite builds the app with `yarn build`. ci.yml already type-checks
        # this commit, so build the way `yarn ci` does: skip Next's in-build
        # type check and cap the heap, which a 7 GB runner needs.
        env:
          OM_SKIP_NEXT_BUILD_TYPECHECK: '1'
          OM_NEXT_BUILD_NODE_OPTIONS: --max-old-space-size=4096
        run: yarn test:integration:ephemeral --app-only

      - name: Upload Playwright report
        if: failure()
        uses: actions/upload-artifact@v7
        with:
          name: playwright-report
          path: .ai/qa/test-results
          retention-days: 7
