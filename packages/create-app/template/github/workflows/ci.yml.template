# Generated by create-mercato-app {{PACKAGE_VERSION}}. This file is yours: edit freely. No Open Mercato command rewrites it.
# Runs `yarn ci` (scripts/ci.mjs): generate, typecheck, lint, ds:check, test, build.
# Set the repository variable OM_CI_RUNS_ON to pick a runner without editing this file.
# Pull requests from forks always run on ubuntu-latest.
# Docs: https://docs.openmercato.com/customization/standalone-app#continuous-integration
name: CI

on:
  pull_request:
  push:
    # create-mercato-app initializes `main`; change this if your default branch differs.
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  quality-gate:
    name: Quality gate
    runs-on: ${{ github.event.pull_request && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-latest' || vars.OM_CI_RUNS_ON || 'ubuntu-latest' }}
    timeout-minutes: 45
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Setup Node.js
        uses: actions/setup-node@v7
        with:
          node-version: 24

      - name: Enable Corepack
        run: corepack enable

      - name: Cache Yarn packages
        uses: actions/cache@v6
        with:
          path: |
            .yarn/cache
            ~/.yarn/berry/cache
          key: yarn-${{ runner.os }}-${{ hashFiles('yarn.lock') }}
          restore-keys: yarn-${{ runner.os }}-

      - name: Check yarn.lock is committed
        run: node scripts/ci.mjs --check-lockfile

      - name: Install dependencies
        run: yarn install --immutable

      - name: Quality gate
        run: yarn ci
