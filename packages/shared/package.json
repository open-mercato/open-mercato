{
  "name": "@open-mercato/shared",
  "version": "0.6.7",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node watch.mjs",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./lib/openapi": {
      "types": "./src/lib/openapi/index.ts",
      "default": "./dist/lib/openapi/index.js"
    },
    "./lib/commands": {
      "types": "./src/lib/commands/index.ts",
      "default": "./dist/lib/commands/index.js"
    },
    "./lib/hotkeys": {
      "types": "./src/lib/hotkeys/index.ts",
      "default": "./dist/lib/hotkeys/index.js"
    },
    "./lib/profiler": {
      "types": "./src/lib/profiler/index.ts",
      "default": "./dist/lib/profiler/index.js"
    },
    "./lib/testing": {
      "types": "./src/lib/testing/index.ts",
      "default": "./dist/lib/testing/index.js"
    },
    "./lib/bootstrap": {
      "types": "./src/lib/bootstrap/index.ts",
      "default": "./dist/lib/bootstrap/index.js"
    },
    "./lib/bootstrap/dynamicLoader": {
      "types": "./src/lib/bootstrap/dynamicLoader.ts",
      "default": "./dist/lib/bootstrap/dynamicLoader.js"
    },
    "./lib/auth/principal-service": {
      "types": "./src/lib/auth/principal-service.ts",
      "default": "./dist/lib/auth/principal-service.js"
    },
    "./lib/webhooks": {
      "types": "./src/lib/webhooks/index.ts",
      "default": "./dist/lib/webhooks/index.js"
    },
    "./lib/events/patterns": {
      "types": "./src/lib/events/patterns.ts",
      "default": "./dist/lib/events/patterns.js"
    },
    "./lib/data/consistency": {
      "types": "./src/lib/data/consistency.ts",
      "default": "./dist/lib/data/consistency.js"
    },
    "./lib/logger": {
      "types": "./src/lib/logger/index.ts",
      "default": "./dist/lib/logger/index.js"
    },
    "./lib/search/tokenLookup": {
      "types": "./src/lib/search/tokenLookup.ts",
      "default": "./dist/lib/search/tokenLookup.js"
    },
    "./modules/generators": {
      "types": "./src/modules/generators/index.ts",
      "default": "./dist/modules/generators/index.js"
    },
    "./*.ts": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./*.tsx": {
      "types": "./src/*.tsx",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./dist/*.js"
    },
    "./*/*": {
      "types": [
        "./src/*/*.ts",
        "./src/*/*.tsx"
      ],
      "default": "./dist/*/*.js"
    },
    "./*/*/*": {
      "types": [
        "./src/*/*/*.ts",
        "./src/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*.js"
    },
    "./*/*/*/*": {
      "types": [
        "./src/*/*/*/*.ts",
        "./src/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*.js"
    }
  },
  "dependencies": {
    "@mikro-orm/core": "^7.1.8",
    "@mikro-orm/decorators": "^7.1.8",
    "@mikro-orm/postgresql": "^7.1.8",
    "@open-mercato/cache": "workspace:*",
    "@types/html-to-text": "^9.0.4",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^17.4.2",
    "html-to-text": "^10.0.0",
    "pino": "^10.3.1",
    "rate-limiter-flexible": "^11.2.0",
    "re2js": "2.8.6",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "2.17.5",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-morph": "^28.0.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-mercato/open-mercato",
    "directory": "packages/shared"
  }
}
