      {
        "stepId": "qualify_gate",
        "stepName": "Qualified?",
        "stepType": "IF_ELSE",
        "description": "Route qualified leads into the survey track"
      },
      {
        "stepId": "financing_gate",
        "stepName": "Financing route",
        "stepType": "SWITCH",
        "description": "Route on the chosen financing option"
      },
      {
        "stepId": "permit_gate",
        "stepName": "Permit outcome",
        "stepType": "IF_ELSE",
        "description": "Route on the permit decision"
      },
      {
        "stepId": "await_grid_approval",
        "stepName": "Await grid approval",
        "stepType": "WAIT_FOR_CONDITION",
        "config": {
          "condition": {
            "operator": "AND",
            "rules": [
              {
                "field": "gridApproval.status",
                "operator": "==",
                "value": "APPROVED"
              }
            ]
          },
          "timeout": "P30D",
          "onTimeout": "FAIL",
          "pollIntervalMs": 3600000
        }
      },
      {
        "stepId": "nurture_lead",
        "stepName": "Nurture unqualified lead",
        "stepType": "AUTOMATED",
        "activities": [
          {
            "activityId": "nurture_lead_email",
            "activityName": "Nurture Lead Email",
            "activityType": "SEND_EMAIL",
            "config": {
              "to": "{{context.customerEmail}}",
              "subject": "Your solar assessment",
              "template": "oze_nurture"
            }
          }
        ]
      },
      {
        "stepId": "cash_financing",
        "stepName": "Cash purchase",
        "stepType": "AUTOMATED",
        "activities": [
          {
            "activityId": "cash_financing_set",
            "activityName": "Cash Financing Set",
            "activityType": "SET_VARIABLE",
            "config": {
              "assignments": [
                {
                  "path": "financing.plan",
                  "value": "CASH"
                }
              ]
            }
          }
        ]
      },
