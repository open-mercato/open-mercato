{
  "workflowId": "oze_residential_install_v1",
  "workflowName": "OZE Residential Install - 60-node density fixture",
  "description": "Sixty-step residential photovoltaic installation pipeline with five agent touchpoints, branching, error routes and activity-dense transitions. Navigability fixture for route chips, semantic zoom and canvas density (spec section 4.4, issue #4244).",
  "version": 1,
  "enabled": false,
  "metadata": {
    "category": "Energy",
    "tags": [
      "oze",
      "density-fixture",
      "agents"
    ],
    "icon": "sun"
  },
