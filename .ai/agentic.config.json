{
  "version": 1,
  "baseBranch": "main",
  "tracker": "github",
  "browser": {
    "provider": "playwright"
  },
  "validation": {
    "commands": [
      "yarn build:packages",
      "yarn generate",
      "yarn build:packages",
      "yarn i18n:check-sync",
      "yarn i18n:check-usage",
      "yarn typecheck",
      "yarn test",
      "yarn build:app"
    ]
  },
  "labels": {
    "enabled": true,
    "pipeline": ["review", "changes-requested", "qa", "qa-failed", "merge-queue", "blocked", "do-not-merge"],
    "category": ["bug", "feature", "refactor", "security", "dependencies", "enterprise", "documentation"],
    "meta": ["needs-qa", "skip-qa", "qa-approved", "qa-self-verified", "in-progress", "ci-monitoring", "screenshots", "claim-reset", "automerge-signal-1-cr", "automerge-signal-2-qa", "automerge-signal-3-ci", "automerge-signal-3-passes-local-ci-checks", "automerge-blocked"],
    "priority": ["priority-low", "priority-medium", "priority-high", "priority-extreme"],
    "risk": ["risk-low", "risk-medium", "risk-high"]
  },
  "qaGate": false,
  "qaGateLabel": "needs-qa",
  "qaReadyLabel": null,
  "humanQaPolicy": { "batchCheckLabel": "qa-batch-check" },
  "qaBatch": { "branchPrefix": "stabilize/", "greenTagPrefix": "green/", "bugLabels": ["bug", "daily-qa"], "blockerLabel": "qa-blocker", "inProgressLabel": "qa-in-progress" },
  "prTriage": { "acceptanceLabel": "needs-triage" },
  "ci": { "maxWaitMinutes": 40 },
  "autofix": { "label": "cez-autofix", "eligibility": { "lookbackDays": 30, "analyzeLimit": 100, "limit": 20, "excludeLabels": ["blocked", "do-not-fix"] } },
  "automerge": {
    "label": "automerge",
    "mode": "prepare-and-merge",
    "requireIndependentReview": true,
    "defaultToHumanQa": false,
    "humanOnlyLabels": ["feature"],
    "humanOnlyAuthors": ["zielivia"],
    "complexQa": "always",
    "windowMinutes": 120,
    "maxAttempts": 3,
    "eligibility": {
      "tiers": [["qa-approved"], ["ai-judgment"], ["security", "small"], ["trusted-author"], ["fixes-issue"]],
      "smallPrFileLimit": 10,
      "aiJudgment": { "staleAfterDays": 7 },
      "securityLabels": ["security"],
      "trustedAuthors": [],
      "excludeAuthorAssociations": ["first-time-contributor", "outside-collaborator", "none"],
      "excludeLabels": ["do-not-merge", "blocked", "qa-failed"],
      "lookbackDays": 30,
      "analyzeLimit": 100,
      "limit": 20
    }
  },
  "engine": { "loopStepThreshold": 20, "executorTier": "standard", "stepReview": "final" },
  "closeKeywords": [],
  "paths": {
    "runs": ".ai/runs",
    "analysis": ".ai/analysis",
    "specs": ".ai/specs",
    "prototypes": ".ai/prototypes",
    "dataModel": ".ai/data-model",
    "scripts": ".ai/scripts",
    "qa": ".ai/qa"
  },
  "reviewChecklist": ".ai/review-checklist.md",
  "securityChecklist": ".ai/security-checklist.md",
  "securityReport": {
    "publish": "pr",
    "disclosure": "withhold-live"
  },
  "help": {
    "data": [".ai/skills/om-help/references/workflow-sequences.md"]
  },
  "sessionShare": {
    "enabled": true,
    "issueRepo": "open-mercato/open-mercato",
    "storageRepo": "open-mercato/open-mercato"
  },
  "smartTest": {
    "map": ".ai/test-map.json",
    "suites": [
      {
        "name": "unit",
        "full": "yarn test",
        "files": [
          "**/__tests__/**/*.test.ts",
          "**/__tests__/**/*.test.tsx"
        ],
        "direct": "yarn jest {tests} --passWithNoTests",
        "related": "yarn jest --findRelatedTests {sources} --passWithNoTests",
        "needsApp": false
      },
      {
        "name": "integration",
        "full": "yarn test:integration",
        "files": [
          "**/__integration__/**/*.spec.ts"
        ],
        "direct": "yarn playwright test {tests} --config=.ai/qa/tests/playwright.config.ts",
        "needsApp": true
      }
    ]
  }
}
