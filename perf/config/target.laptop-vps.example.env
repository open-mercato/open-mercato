# Tester laptop -> remote SUT (the decided setup: no generator VPS).
# Copy to perf/config/target.local.env (gitignored) on the laptop and fill in the <...> values.
# Keys are defined in perf/docs/contracts.md (Target config).

# Free-form label recorded in run.json.
PERF_TARGET_NAME=vps-round1
PERF_TARGET_KIND=vps
# k6 traffic and perf/bin/perf control calls both go straight to the SUT's TLS proxy over the internet.
# The SUT firewall must allow PERF_TLS_PORT from this laptop's public IP only.
BASE_URL=https://<sut-public-ip>:8443
CONTROL_BASE_URL=https://<sut-public-ip>:8443
CALIBRATE_URL=
# Commands (up, seed, snapshot, restore, psql) run on the SUT over SSH.
SUT_SSH=perf@<sut-public-ip>
SUT_REPO_DIR=/srv/open-mercato
# Comparability keys. Keep GENERATOR_LOCATION identical for every run of a round
# (same laptop, same place, same connection), e.g. laptop-<name>-<office|home>-wired.
GENERATOR_LOCATION=laptop-<name>-<site>-wired
HARDWARE_PROFILE=vps-6c16g
# k6 runs on the default Docker bridge and reaches the laptop's SSH tunnel via host.docker.internal.
# Linux laptop: use GENERATOR_NETWORK=host and PROM_RW_URL=http://127.0.0.1:19090/api/v1/write instead.
GENERATOR_NETWORK=laptop
K6_NETWORK=
# Prometheus on the SUT, reached through `ssh -N -L 19090:127.0.0.1:9090 -L 13300:127.0.0.1:3300 <SUT_SSH>`.
PROM_RW_URL=http://host.docker.internal:19090/api/v1/write
PROM_QUERY_URL=http://127.0.0.1:19090
# 1 = accept the self-signed certificate of the Caddy tls service.
INSECURE_TLS=1
