# SUT environment for the om-perf compose project.
# perf/bin/perf init-secrets copies this file to perf/config/sut.local.env (gitignored, mode 600)
# and replaces every __GENERATE__ placeholder with a fresh secret. It never overwrites an existing value.
# Values here are interpolated into docker-compose.fullapp.yml + perf/sut/compose.perf.yml +
# perf/monitoring/compose.monitoring.yml. Size the tuning block from perf/config/hardware.md.

# --- Identity of the stack (perf/docs/contracts.md) ---
COMPOSE_PROJECT_NAME=om-perf
DEPLOY_ENV=perf
POSTGRES_DB=open-mercato
POSTGRES_USER=postgres

# --- Mandatory secrets: `perf/bin/perf up` refuses compose defaults or placeholders ---
# Postgres superuser password (compose default `postgres` must never reach a VPS).
POSTGRES_PASSWORD=__GENERATE__
# JWT signing secret (no compose default; a published value lets anyone forge tokens).
JWT_SECRET=__GENERATE__
# Meilisearch master key (compose default `meilisearch-dev-key`).
MEILISEARCH_MASTER_KEY=__GENERATE__
# Password for the bootstrap superadmin created by `mercato init` (compose default `password`).
OM_INIT_SUPERADMIN_EMAIL=superadmin@perf.local
OM_INIT_SUPERADMIN_PASSWORD=__GENERATE__
# Grafana admin password (Grafana binds to 127.0.0.1; anonymous users are read-only viewers).
GRAFANA_ADMIN_PASSWORD=__GENERATE__
# Shared secrets the app expects in production; unique per SUT.
NEXTAUTH_SECRET=__GENERATE__
CONSENT_INTEGRITY_SECRET=__GENERATE__
DOMAIN_CHECK_SECRET=__GENERATE__
DOMAIN_RESOLVE_SECRET=__GENERATE__

# --- Tenant data encryption (production default, no Vault) ---
# The two keys are part of every snapshot: a snapshot is unreadable without the keys it was seeded with.
# `snapshot` stores a fingerprint and a key backup in perf/.state/snapshots/, `restore` refuses a mismatch.
TENANT_DATA_ENCRYPTION=true
TENANT_DATA_ENCRYPTION_FALLBACK_KEY=__GENERATE__
LOOKUP_HASH_PEPPER=__GENERATE__

# --- Measured configuration: everything else stays at compose defaults ---
# CACHE_STRATEGY=redis and ENABLE_CRUD_API_CACHE=true come from the base compose file (measure what ships).
ENABLE_CRUD_API_CACHE=true
NODE_ENV=production
# All VUs log in from one generator IP; the default (20/min) would lock them out. Other limits stay default.
RATE_LIMIT_LOGIN_IP_POINTS=10000
# Fraction of requests that are traced. Metrics (pool, event loop, heap) do not depend on it.
TELEMETRY_SAMPLING_RATIO=0.01

# --- Hardware-derived tuning (perf/config/hardware.md, profile local-mac shown) ---
# Web (app) connection pool and Node heap.
DB_POOL_MAX=20
DB_POOL_MIN=2
NODE_OPTIONS=--max-old-space-size=3072
# Worker container (yarn mercato queue worker --all) pool and heap.
WORKER_DB_POOL_MAX=8
WORKER_NODE_OPTIONS=--max-old-space-size=2048
# Redis is shared by cache and BullMQ with noeviction; a full Redis fails writes.
REDIS_MAXMEMORY=512mb
# Postgres memory settings (passed as `postgres -c` flags by perf/sut/compose.perf.yml).
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_SHM_SIZE=1gb
PG_RANDOM_PAGE_COST=1.1

# --- Network exposure ---
# Public origin of the app as the browser sees it (cookies, redirects, e-mail links).
APP_URL=https://localhost:8443
# Extra origins accepted by the app (the k6 container reaches the proxy as https://tls:8443).
PERF_APP_ALLOWED_ORIGINS=https://tls:8443,https://localhost:8443
# Address the TLS proxy publishes on. Local: 127.0.0.1. VPS: the private IP shared with the generator.
PERF_TLS_BIND=127.0.0.1
PERF_TLS_PORT=8443
PERF_TLS_HTTP_PORT=8080
# Extra hostname or IP in the self-signed certificate (VPS: the private IP the generator uses).
PERF_TLS_HOST=127.0.0.1
# Caddyfile.internal = self-signed (default). Caddyfile.domain = ACME certificate for PERF_TLS_DOMAIN
# (needs PERF_TLS_PORT=443, PERF_TLS_HTTP_PORT=80 and a reachable public address).
PERF_TLS_CADDYFILE=Caddyfile.internal
PERF_TLS_DOMAIN=
PERF_TLS_EMAIL=
# Loopback-only UIs.
GRAFANA_PORT=3300
PROMETHEUS_PORT=9090
MAILPIT_UI_PORT=8025
PROMETHEUS_RETENTION=30d

# --- Must stay unset: no external calls during a run ---
NEW_RELIC_LICENSE_KEY=
RESEND_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Docker Desktop (macOS/Windows) cannot propagate the host root mount; use "ro" there. Linux VPS: keep the default "ro,rslave".
# NODE_EXPORTER_ROOT_MOUNT_OPTS=ro,rslave
