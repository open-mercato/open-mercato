# Copy to perf/config/target.local.env (gitignored). perf/bin/perf never targets anything else.
# Keys are defined in perf/docs/contracts.md (Target config).

# Free-form label recorded in run.json.
PERF_TARGET_NAME=local
# local | vps
PERF_TARGET_KIND=local
# URL k6 uses, from inside the generator container. Local: the Caddy service on the SUT network.
BASE_URL=https://tls:8443
# URL perf/bin/perf itself uses (users, reindex, calibration). Local: the published loopback port.
CONTROL_BASE_URL=https://localhost:8443
# Calibration target; defaults to CONTROL_BASE_URL. On a VPS run it from the generator against BASE_URL.
CALIBRATE_URL=
# Empty = run docker commands locally. Otherwise user@host of the SUT; commands run over ssh.
SUT_SSH=
# Repository checkout on the SUT (vps only); compose commands run from there.
SUT_REPO_DIR=
# Comparability keys recorded in run.json.
GENERATOR_LOCATION=laptop-local
HARDWARE_PROFILE=local-mac
# Docker network the k6 container joins when local. For a remote SUT use target.laptop-vps.example.env instead
# (GENERATOR_NETWORK=laptop). See perf/docs/contracts.md for the sut | host | laptop modes.
K6_NETWORK=mercato-network-perf-v2
# Prometheus remote-write URL as seen by k6. VPS: http://127.0.0.1:19090/api/v1/write through
# `ssh -N -L 19090:127.0.0.1:9090 <SUT_SSH>` on the generator.
PROM_RW_URL=http://prometheus:9090/api/v1/write
# Prometheus query URL as seen by perf/bin/perf (report). VPS: http://127.0.0.1:19090 through the same tunnel.
PROM_QUERY_URL=http://127.0.0.1:9090
# k6 only: 1 = k6 protocol VUs skip certificate verification and browser VUs ignore HTTPS errors (k6 cannot load
# a custom CA). The perf/bin/perf Node scripts always verify TLS; `up` stores Caddy's local root CA in
# perf/.state/caddy-root.crt and trusts it (in-process when Node has tls.setDefaultCACertificates, otherwise via NODE_EXTRA_CA_CERTS).
INSECURE_TLS=1
